# コピーして .env を作る: cp .env.example .env （make setup でも自動作成される）
# .env は git 管理外。値は各自で設定する。

# MySQL（docker compose が使用）
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=moomoo
DB_PASSWORD=change-me
DB_NAME=moomoo_trading

# ホストで直接動かすとき（make api-dev / make bot-dev / make migrate）の接続先
# docker compose はホスト側に MySQL=3308, Redis=6380 で公開している
DB_HOST=127.0.0.1
DB_PORT=3308
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# NextAuth（make setup が未設定なら自動生成する。手動なら: openssl rand -base64 32）
NEXTAUTH_SECRET=

# API の認証トークン（make setup が未設定なら自動生成する。手動なら: openssl rand -hex 32）
# Web サーバーが /api/v1/* を API に転送するときに付け、API はこれが無いリクエストを拒否する
API_TOKEN=

# ---- bot（任意。未設定なら既定値で動く） ---------------------------------------
# Slack の Incoming Webhook。設定すると約定・決済・エラー・Kill Switch・日次サマリを通知する
# SLACK_WEBHOOK_URL=
# 足の確定と損切りを確認する間隔 / 建玉をブローカーと照合する間隔
# TRADER_POLL_INTERVAL=30s
# TRADER_RECONCILE_INTERVAL=5m
# Paper 口座の初期資金（円）
# PAPER_INITIAL_BALANCE=30000
# リスクの上限（数量・同時建玉数・日次/週次の損失。円）
# RISK_ACCOUNT_MAX_UNITS=1000
# RISK_ACCOUNT_MAX_POSITIONS=1
# RISK_ACCOUNT_MAX_DAILY_LOSS=500
# RISK_ACCOUNT_MAX_WEEKLY_LOSS=1500
# RISK_GLOBAL_MAX_POSITIONS=3
# RISK_GLOBAL_MAX_DAILY_LOSS=1000
# RISK_GLOBAL_MAX_WEEKLY_LOSS=3000
# true にすると、DB の状態に関係なく新規の発注を止める
# KILL_SWITCH=false

# ---- 本番ブローカー（GMOコイン）。すべて揃ったときだけ実際に発注する -----------------
# BROKER_MODE=live
# LIVE_CONFIRM=yes
# GMO_API_KEY=
# GMO_API_SECRET=
# GMO_ACCOUNT_ID=default
