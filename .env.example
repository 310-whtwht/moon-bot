# コピーして .env を作る: cp .env.example .env （make setup でも自動作成される）
# .env は git 管理外。値は各自で設定する。

# MySQL（docker compose が使用）
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=moomoo
DB_PASSWORD=change-me
DB_NAME=moomoo_trading

# ホストで直接動かすとき（make api-dev / make bot-dev / make migrate）の接続先
# docker compose はホスト側に MySQL=3308, Redis=6380 で公開している
DB_HOST=127.0.0.1
DB_PORT=3308
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# NextAuth（make setup が未設定なら自動生成する。手動なら: openssl rand -base64 32）
NEXTAUTH_SECRET=

# API の認証トークン（make setup が未設定なら自動生成する。手動なら: openssl rand -hex 32）
# Web サーバーが /api/v1/* を API に転送するときに付け、API はこれが無いリクエストを拒否する
API_TOKEN=
