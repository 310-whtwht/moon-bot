SKIP = {d: True for d in SKIP_DAYS}

def bar_minutes(bar):
    """足の長さ（分）。連続する足の時刻の差のうち最小のもの。"""
    prev = state.get("prev_time")
    state["prev_time"] = bar.time
    if prev != None:
        gap = (bar.time - prev) // 60
        if gap > 0 and (state.get("len") == None or gap < state["len"]):
            state["len"] = gap
    return state.get("len")

def is_gotobi(bar):
    if bar.weekday > 4:
        return False
    days = [5, 10, 15, 20, 25, bar.days_in_month]
    if bar.day in days:
        return True
    # 土日に当たるゴトー日は、前の金曜日に繰り上がる
    if bar.weekday == 4:
        for ahead in (1, 2):
            if bar.day + ahead <= bar.days_in_month and (bar.day + ahead) in days:
                return True
    return False

def on_bar(bar, pos):
    length = bar_minutes(bar)
    a = atr(int(p.atr_period))
    if length == None or a == None:
        return hold()

    closes_at = bar.hour * 60 + bar.minute + length
    today = bar.year * 10000 + bar.month * 100 + bar.day
    skipped = p.skip == 1 and SKIP.get(today, False)
    gotobi = is_gotobi(bar)
    explain(("ゴトー日" if gotobi else "通常日") + ("（見送る日）" if skipped else ""))

    if pos != None and closes_at == p.exit_min:
        return exit(reason="仲値後の時間切れ")
    if pos == None and closes_at == p.fix_min and gotobi and not skipped:
        return sell(stop=bar.close + p.stop_atr * a, reason="仲値後の売り")
    return hold()
