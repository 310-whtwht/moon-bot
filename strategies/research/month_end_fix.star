# 月末のフィキシングのあとの買い（USD/JPY 5分足向け）
#
# 月の最後の平日の 16:00（ロンドン）で買い、hold_bars 本あとに決済する。
# 評価は docs/backtests/2026-11-01-new-ideas.md。USD/JPY だけで出た候補で、確定した結果ではない。
#
# FIX_BARS は、買いを出す足（16:00 の直前の5分足）の開始時刻（日本時間、YYYYMMDDHHMM）。
# 英国の夏時間で時刻が変わるので一覧で持つ。2027年より先の日付は入っていない。

PARAMS = {
    "hold_bars": 12,
    "atr_period": 14,
    "stop_atr": 3.0,
}

FIX_BARS = [
    202311010055, 202312010055, 202312300055, 202402010055, 202403010055, 202403300055,
    202404302355, 202405312355, 202406282355, 202407312355, 202408302355, 202409302355,
    202411010055, 202411300055, 202501010055, 202502010055, 202503010055, 202503312355,
    202504302355, 202505302355, 202506302355, 202507312355, 202508292355, 202509302355,
    202511010055, 202511290055, 202601010055, 202601310055, 202602280055, 202603312355,
    202604302355, 202605292355, 202606302355, 202607312355, 202608312355, 202609302355,
    202610310055, 202612010055, 202701010055, 202701300055, 202702270055, 202703312355,
    202704302355, 202705312355, 202706302355, 202707302355, 202708312355, 202709302355,
    202710292355, 202712010055, 202801010055,
]

FIX = {t: True for t in FIX_BARS}

def on_bar(bar, pos):
    a = atr(int(p.atr_period))
    if a == None:
        return hold()

    if pos != None:
        state["held"] = state.get("held", 0) + 1
        if state["held"] >= p.hold_bars:
            return exit(reason="フィキシング後の時間切れ")
        return hold()

    now = bar.year * 100000000 + bar.month * 1000000 + bar.day * 10000 + bar.hour * 100 + bar.minute
    if FIX.get(now, False):
        state["held"] = 0
        return buy(stop=bar.close - p.stop_atr * a, reason="フィキシング後の買い")
    return hold()
