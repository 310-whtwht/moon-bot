# Vercel の Production 環境に設定する値（npm run env:push でアップロード）
# このファイルを .env.prod にコピーして値を入れる。.env.prod は git 管理外。
# ADMIN_* は npm run auth:setup で生成できる。
# $ を含む値（パスワードハッシュ）はシングルクォートで囲むと安全。

# セッションの暗号化キー（空のままなら env:push 時に自動生成して書き戻す）
AUTH_SECRET=

# 管理者ユーザー
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=''
# 設定するとログイン時に 2FA（6桁コード）が必須になる
ADMIN_TOTP_SECRET=

# API（Go）を公開したら設定する。Web サーバーが /api/v1/* をここへ転送し、トークンを付ける
# API_URL=https://api.example.com
# API_TOKEN=
